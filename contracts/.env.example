# MAINNET. Real funds. Do not commit .env.

DEPLOYER_PRIVATE_KEY=
VAULT_ADMIN_PRIVATE_KEY=
USER_PRIVATE_KEY=
ATTACKER_FUNDER_PRIVATE_KEY=

DEPLOYER_ADDRESS=
VAULT_ADMIN_ADDRESS=
USER_ADDRESS=
ATTACKER_FUNDER_ADDRESS=
# Filled in before distribute.ps1 -Execute. No private key; deployer sends gas to this address.
CRE_BROADCAST_ADDRESS=

# Where scripts/SweepAll.ps1 sends leftover mainnet funds. Chain-specific values win.
RECOVERY_ADDRESS=
RECOVERY_ADDRESS_BSC=
RECOVERY_ADDRESS_BASE=

# NOWNodes BNB mainnet URL incl. API key
BSC_RPC=
# NOWNodes Base mainnet URL incl. API key
BASE_RPC=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=

# MOCK forwarder for BNB mainnet (simulation) — from CRE Supported Networks docs
CRE_FORWARDER_BSC=
# MOCK forwarder for Base mainnet (simulation)
CRE_FORWARDER_BASE=

PAUSE_THRESHOLD=80

# Base demo deposits. 0.0025 ETH total, under the 0.009393 ETH cap. The same wei amounts are also under the BNB cap.
SEED_ADMIN_WEI=2000000000000000
SEED_USER_WEI=500000000000000

# Optional extra allowlist entry for Allowlist.s.sol. Leave unset to skip.
# FRESH_WALLET=
# SetForwarder.s.sol refuses address(0).
# NEW_FORWARDER=
# LockWorkflow.s.sol, used after the CRE workflow exists.
# EXPECTED_WORKFLOW_ID=
# EXPECTED_AUTHOR=

# npm run sync copies abi/ and deployments/8453.json into each path. Quote Windows paths.
# BACKEND_SHARED_PATH=
# FRONTEND_SHARED_PATH=
# CRE_SHARED_PATH=

# about $2 of BNB (priced at $757.59 on 2026-09-28)
MIXER_DENOM_BSC_WEI=2640000000000000
# about $2 of ETH (priced at $2661.44 on 2026-09-28)
MIXER_DENOM_BASE_WEI=751000000000000
# about $25 of BNB
MAX_TVL_BSC_WEI=32999000000000000
# about $25 of ETH
MAX_TVL_BASE_WEI=9393000000000000
