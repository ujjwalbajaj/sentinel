# Gas key for `cre workflow simulate --broadcast`. Fund this wallet on BNB Chain and Base.
# Never commit a real private key. `.env` is gitignored.
CRE_ETH_PRIVATE_KEY=

# Full NOWNodes mainnet HTTP URLs, including the API key path segment.
# project.yaml references these names.
BSC_RPC=
BASE_RPC=

# Public EVM address of the backend signer allowed to trigger the workflow.
BACKEND_SIGNER_ADDRESS=

# Absolute path to the SENTINEL contracts repo. Used by `bun run sync`.
CONTRACTS_REPO_PATH=
