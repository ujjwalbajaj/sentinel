# Backend REST origin, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8787

# socket.io uses NEXT_PUBLIC_API_URL (the /live namespace).
# NEXT_PUBLIC_WS_URL is only a fallback when the API URL is unset.
# Use localhost, not 127.0.0.1, so the session cookie stays same-site with the app.
NEXT_PUBLIC_WS_URL=http://localhost:8787

# Public read-only build: hides the attack simulator, admin actions, and onboarding submit.
NEXT_PUBLIC_PUBLIC_MODE=false

# Public read RPCs. Do not put a NOWNodes key in this frontend.
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_BSC_RPC=https://bsc-dataseed.bnbchain.org

# Show the demo console. Copy DEMO_TOKEN from the backend .env into .env.local.
NEXT_PUBLIC_DEMO=true
NEXT_PUBLIC_DEMO_TOKEN=

# From https://cloud.walletconnect.com — injected wallets still work without it
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
