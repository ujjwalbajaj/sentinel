# NOWNodes. Header api-key on HTTPS. WSS uses wss://<host>/wss/<key>.
NOWNODES_API_KEY=
BSC_RPC=https://bsc.nownodes.io
BSC_WSS=wss://bsc.nownodes.io/wss
BASE_RPC=https://base.nownodes.io
BASE_WSS=wss://base.nownodes.io/wss

# Neon Postgres. sslmode=require. DATABASE_URL is pooled. DIRECT_URL is unpooled (migrations).
DATABASE_URL=
DIRECT_URL=

# Full path to the cre executable. The backend does not look it up on PATH.
CRE_BIN=
CRE_MODE=simulate
CRE_REPO_PATH=
CRE_WORKFLOW_NAME=
CRE_TARGET=
CRE_HTTP_URL=
CRE_GATEWAY_URL=
CRE_WORKFLOW_ID=
CRE_TRIGGER_SIGNER_KEY=

PORT=8787
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
SIWE_DOMAIN=127.0.0.1
SIWE_URI=http://127.0.0.1:8787

# Demo console. These keys spend gas. They are never returned by the API.
# There is no pauser key. CRE pauses. Reset calls vault.unpause() only.
DEMO_TOKEN=
VAULT_ADMIN_PRIVATE_KEY=
USER_PRIVATE_KEY=
ATTACKER_FUNDER_PRIVATE_KEY=
DEMO_PROBE_WEI_8453=200000000000000
DEMO_STRIKE_WEI_8453=150000000000000
DEMO_STRIKE_REENTRIES=10
VAULT_ADMIN_FLOOR_WEI=1000000000000000
USER_FLOOR_WEI=1000000000000000
ATTACKER_FUNDER_FLOOR_WEI=1000000000000000
FRESH_WALLET_FLOOR_WEI=500000000000000

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_URL=https://api.openai.com/v1/chat/completions
