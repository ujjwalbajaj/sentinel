{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SENTINEL CRE Evidence",
  "description": "Mirrors sentinel-guard/evidence.ts. additionalProperties is false at both levels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["incidentId", "chain", "vault", "suspectTxHash", "attacker", "features"],
  "properties": {
    "incidentId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "chain": { "enum": ["bsc", "base"] },
    "vault": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "suspectTxHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "attacker": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "walletAgeSeconds",
        "mixerFunded",
        "reentrancyDetected",
        "vaultBalanceDeltaBps",
        "flashLoanEntry",
        "newContractTarget"
      ],
      "properties": {
        "walletAgeSeconds": { "type": "integer", "minimum": 0 },
        "mixerFunded": { "type": "boolean" },
        "reentrancyDetected": { "type": "boolean" },
        "vaultBalanceDeltaBps": { "type": "integer" },
        "flashLoanEntry": { "type": "boolean" },
        "newContractTarget": { "type": "boolean" }
      }
    }
  }
}
