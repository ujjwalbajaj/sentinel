{
  "name": "sentinel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "watch:only": "tsx src/index.ts --watch-only",
    "test": "tsx --test src/detector/decide.test.ts src/shared/incident-id.test.ts src/shared/cre-spawn.test.ts src/shared/cre/score-fixture.test.ts src/shared/cre/payload.test.ts src/shared/cre-verdict.test.ts src/shared/watcher-guard.test.ts",
    "sync:cre": "tsx scripts/sync-cre.ts",
    "typecheck": "tsc --noEmit",
    "check:nownodes": "tsx scripts/check-nownodes.ts",
    "check:cre": "tsx scripts/check-cre.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "koffi": "^2.14.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "viem": "^2.23.2",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
